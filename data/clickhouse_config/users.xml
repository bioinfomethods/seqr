<?xml version="1.0"?>                                                                                                                                                                                                                                                                                                     
<clickhouse>                                                                                                                                                                                                                                                                                                              
    <profiles>                                                                                                                                                                                                                                                                                                            
        <default>                                                                                                                                                                                                                                                                                                         
            <max_memory_usage>10000000000</max_memory_usage>                                                                                                                                                                                                                                                              
            <use_uncompressed_cache>0</use_uncompressed_cache>                                                                                                                                                                                                                                                            
            <load_balancing>random</load_balancing>                                                                                                                                                                                                                                                                       
            <flatten_nested>0</flatten_nested>  <!-- Add this line -->                                                                                                                                                                                                                                                    
            <max_query_size>10485760</max_query_size>  <!-- 10 MB, up from default 256 KB -->
        </default>                                                                                                                                                                                                                                                                                                        
    </profiles>                                                                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                                                          
    <users>                                                                                                                                                                                                                                                                                                               
        <default>                                                                                                                                                                                                                                                                                                         
            <password></password>                                                                                                                                                                                                                                                                                         
            <networks>                                                                                                                                                                                                                                                                                                    
                <ip>::/0</ip>                                                                                                                                                                                                                                                                                             
            </networks>                                                                                                                                                                                                                                                                                                   
            <profile>default</profile>                                                                                                                                                                                                                                                                                    
            <quota>default</quota>                                                                                                                                                                                                                                                                                        
        </default>                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                          
        <seqr_user>                                                                                                                                                                                                                                                                                                       
            <password>docker-compose-clickhouse-password</password>                                                                                                                                                                                                                                                       
            <networks>                                                                                                                                                                                                                                                                                                    
                <ip>::/0</ip>                                                                                                                                                                                                                                                                                             
            </networks>                                                                                                                                                                                                                                                                                                   
            <profile>default</profile>  <!-- This ensures seqr_user uses the default profile with flatten_nested=0 -->                                                                                                                                                                                                    
            <quota>default</quota>                                                                                                                                                                                                                                                                                        
            <!-- required so init-permissions.sql can GRANT NAMED COLLECTION ADMIN;
                 XML-defined users otherwise have no WITH GRANT OPTION rights -->
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
            <show_named_collections>1</show_named_collections>
            <show_named_collections_secrets>1</show_named_collections_secrets>
        </seqr_user>                                                                                                                                                                                                                                                                                                      
    </users>                                                                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                                                          
    <quotas>                                                                                                                                                                                                                                                                                                              
        <default>                                                                                                                                                                                                                                                                                                         
            <interval>                                                                                                                                                                                                                                                                                                    
                <duration>3600</duration>                                                                                                                                                                                                                                                                                 
                <queries>0</queries>                                                                                                                                                                                                                                                                                      
                <errors>0</errors>                                                                                                                                                                                                                                                                                        
                <result_rows>0</result_rows>                                                                                                                                                                                                                                                                              
                <read_rows>0</read_rows>                                                                                                                                                                                                                                                                                  
                <execution_time>0</execution_time>                                                                                                                                                                                                                                                                        
            </interval>                                                                                                                                                                                                                                                                                                   
        </default>                                                                                                                                                                                                                                                                                                        
    </quotas>                                                                                                                                                                                                                                                                                                             
</clickhouse>                                                                                                                                                                                                                                                                                                             
