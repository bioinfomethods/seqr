# Template for .env, which docker compose reads automatically. Copy and edit:
#
#     cp .env.example .env
#
# Everything here is OPTIONAL. docker-compose.yml already defaults to the local Keycloak
# in data/keycloak/realm-seqr.json, so a clean checkout runs standalone with no .env at
# all -- sign in at http://localhost:8000 as tester / tester.
#
# .gitignore excludes .env and .env.* but keeps this file, so it must never hold real
# credentials.

############################################################
# Seeded Django account and project (scripts/reset.sh)
############################################################
# Must match the email the identity provider asserts: the login pipeline associates an
# OIDC identity with a PRE-EXISTING Django account carrying the same address. Defaults to
# the local realm's tester.
#SEQR_TEST_USER_EMAIL=tester@seqr.local
#SEQR_TEST_PROJECT_NAME=Test Project
#SEQR_TEST_PROJECT_GENOME_VERSION=38

############################################################
# Using the hosted MCRI Keycloak instead of the local realm
############################################################
# SOCIAL_AUTH_INTERNAL_API_URL does NOT need setting: it follows SOCIAL_AUTH_API_URL
# whenever that is set, so both halves of the login flow move together. Set it only for
# the unusual case where this container must reach the provider at a different address
# than the browser does (which is exactly what the local Keycloak needs, and why the
# variable exists at all).
#
# OIDC_SCOPE, by contrast, MUST be set here. docker-compose.yml defaults it to the
# reduced set the local realm accepts. The MCRI realm defines ad_groups and groups as
# client scopes, and without requesting them the token carries no groups claim -- login
# still succeeds, but associate_groups then finds nothing and strips the user's
# project-manager and analyst grants on the way in.
#
# Set SOCIAL_AUTH_KEYCLOAK_PUBLIC_KEY explicitly for a hosted realm (Realm Settings >
# Keys > RS256 > Public key). Left empty, the seqr entrypoint fetches it from the realm
# at boot, which works but makes startup depend on the provider being reachable.
#
#SOCIAL_AUTH_API_URL=https://keycloak.mcri.edu.au:8888/realms/bioinfomethods-test
#SOCIAL_AUTH_CLIENT_ID=archietest
#SOCIAL_AUTH_CLIENT_SECRET=
#SOCIAL_AUTH_KEYCLOAK_PUBLIC_KEY=
#OIDC_SCOPE=openid profile email ad_groups groups offline_access
#ARCHIE_API_ROOT_URL=https://archietest.mcri.edu.au

############################################################
# Other
############################################################
# Bypasses OIDC entirely for functional tests (POST /test_login with an email).
#ENABLE_TEST_LOGIN=true
# Local Keycloak admin console at http://localhost:8080
#KEYCLOAK_ADMIN_USER=admin
#KEYCLOAK_ADMIN_PASSWORD=admin
